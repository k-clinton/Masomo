# Server-only Resend credentials. Never prefix these with NEXT_PUBLIC_.
RESEND_API_KEY=

# Use a sender on a domain verified in Resend.
# HARNES_FROM_EMAIL=Harnes 24/7 <hello@your-verified-domain.com>
HARNES_FROM_EMAIL=

# Optional local test recipient. Omit in production to use the business email in src/data/site.ts.
HARNES_CONTACT_EMAIL=